  "text": "def valid_date(date):\n    \"\"\"Validate a date string based on specific rules.\"\"\"\n    if not date:\n        return False\n    \n    try:\n        mm, dd, yyyy = map(int, date.split('-'))\n    except ValueError:\n        return False\n    \n    if not (1 <= mm <= 12):\n        return False\n    \n    if mm in [1, 3, 5, 7, 8, 10, 12]:\n        max_days = 31\n    elif mm in [4, 6, 9, 11]:\n        max_days = 30\n    else:  # February\n        max_days = 29\n    \n    if not (1 <= dd <= max_days):\n        return False\n    \n    return True",
