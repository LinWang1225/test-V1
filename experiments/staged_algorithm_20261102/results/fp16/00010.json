  "text": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the longest palindrome suffix and construct the shortest palindrome.\"\"\"\n    if not string:\n        return string\n    \n    # Find the longest palindromic suffix\n    for i in range(len(string), 0, -1):\n        if string[i:] == string[i:][::-1]:\n            # Found the longest palindromic suffix\n            return string + string[:len(string) - i][::-1]\n    \n    # If no palindromic suffix found (e.g., empty string)\n    return string + string[::-1]",
