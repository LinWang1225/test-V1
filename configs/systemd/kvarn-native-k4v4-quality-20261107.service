[Unit]
Description=Paired TurboQuant and KVarN K4V4 task quality extension
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/wanglin/kvarn-profile-20261019
ExecStart=/home/wanglin/kvarn-profile-20261019/.venv/bin/python -u /home/wanglin/kvarn-profile-20261019/experiments/native_k4v4_quality_20261107/src/run_queue.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=MAX_JOBS=4
